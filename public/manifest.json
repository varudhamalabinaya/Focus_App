{
  "manifest_version": 3,
  "name": "Focus — Session Protection",
  "version": "0.1.0",
  "description": "Start a focused work session and block selected websites until it ends.",
  "incognito": "spanning",
  "action": {
    "default_popup": "index.html",
    "default_title": "Focus",
    "default_icon": "icon-128.png"
  },
  "icons": {
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
