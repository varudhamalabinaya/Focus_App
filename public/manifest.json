{
  "manifest_version": 3,
  "name": "Focus — Commitment Protection",
  "version": "0.1.0",
  "description": "A local prototype for evidence-based accountability and deliberate website access.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Focus"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "*://*.reddit.com/*"
  ]
}
